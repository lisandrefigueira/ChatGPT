# Copie para .env e preencha. Nunca commitar o .env real.

# Auth simples (camada extra sobre o Tailscale) — qualquer string longa e aleatória
APP_TOKEN=troque-por-um-token-aleatorio-longo

# STT — https://console.groq.com/keys
GROQ_API_KEY=

# TTS — caminho para o JSON de credenciais de uma service account do Google Cloud
# com a API "Cloud Text-to-Speech" habilitada
GOOGLE_APPLICATION_CREDENTIALS=/caminho/para/service-account.json

# LLM — "openai" ou "anthropic"
LLM_PROVIDER=openai
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-haiku-4-5-20251001

# Diretório de dados (cache TTS, log de custos, sqlite) — padrão: ./data
LINGUA_DATA_DIR=./data

# Usado pelo frontend em build/dev
VITE_API_BASE=http://localhost:8000
VITE_APP_TOKEN=troque-por-um-token-aleatorio-longo
